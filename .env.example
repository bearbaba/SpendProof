# Live SERV requests are OFF by default (avoid accidental API charges)
SPENDPROOF_ENABLE_LIVE_SERV=false
# Maximum price the server will sign for one purchase (USDC), default 1.00, allowed up to 100.00
# This does not enforce limits in the separately operated Kite CLI
SPENDPROOF_MAX_SIGNED_TX_USD=1.00
# Server-only OpenServ reasoning credentials
SERV_REASONING_API_KEY=
# Obtain a valid model ID from your OpenServ console
SERV_MODEL=
# An access code required to prevent unauthenticated callers from burning SERV credits
# Use a separate 16+ character access code (not your API key)
SPENDPROOF_ACCESS_CODE=
# Server-only HMAC secret for decision attestation (at least 32 random characters)
SPENDPROOF_AUDIT_SECRET=
